{
  "info": {
    "name": "API CI Smoke (Auth)",
    "description": "Subconjunto mínimo da collection completa (mantida em API_docs/Inspecta-API.postman_collection.json) usado só pelo build-runner (ci/entrypoint.sh) para provar que o inspecta-api recém-buildado sobe, aplica o Flyway e serve login de verdade contra um Postgres/RabbitMQ efêmeros. Login usa o admin da migration db/migration-ci/V900__ci_seed_admin.sql — nunca existe fora desse stack descartável.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"senha\": \"{{userSenha}}\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ok = pm.response.code === 200;",
              "pm.test('login 200', () => pm.expect(ok).to.be.true);",
              "if (ok) {",
              "    const b = pm.response.json();",
              "    pm.collectionVariables.set('accessToken', b.accessToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "logout"] }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('logout 204', () => pm.expect(pm.response.code).to.equal(204));"]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "" },
    { "key": "userEmail", "value": "" },
    { "key": "userSenha", "value": "" },
    { "key": "accessToken", "value": "" }
  ]
}
