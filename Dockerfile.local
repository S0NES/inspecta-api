# Runtime-only image for the LOCAL all-Docker dev stack (docker-compose.local.yml).
# The jar is built on the host (mvn package) so this needs no Reposilite access.
# Prod builds still use ./Dockerfile.
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN apk add --no-cache wget
COPY target/*.jar app.jar
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=10 --start-period=90s \
  CMD wget -qO- http://localhost:8080/actuator/health | grep -q UP || exit 1
ENTRYPOINT ["java","-XX:MaxRAMPercentage=75","-jar","app.jar"]
