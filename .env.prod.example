# ============================================================================
# inspecta-api/.env.prod — copie para .env.prod na VPS e preencha.
#   cp .env.prod.example .env.prod && nano .env.prod
#
# No profile `prod` o inspecta-api FALHA O BOOT se qualquer variável abaixo marcada
# como obrigatória estiver ausente (T7.5, proposital). Se o container ficar em
# restart loop, é quase sempre isso — `docker compose logs inspecta-api` mostra qual.
# NUNCA commitar .env.prod.
# ============================================================================

# --- Roteamento / Traefik (usado só para montar os labels) -----------------
API_HOST=api.seudominio.com.br
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- CORS (OBRIGATÓRIO) -----------------------------------------------------
# inspecta-web roda no Cloudflare Pages, não é mais same-origin com o inspecta-api — origem(s)
# exata(s) do inspecta-web, separadas por vírgula se houver mais de uma (ex.: domínio de
# preview do Pages além do domínio custom). Nunca "*": o auth usa cookie httpOnly
# com credentials, e "*" é rejeitado pelo browser junto com allow-credentials.
CORS_ALLOWED_ORIGINS=https://app.seudominio.com.br

# --- Banco (OBRIGATÓRIO) ---------------------------------------------------
# `postgres` é o alias do container da stack infra/ na rede inspecta-net.
DATABASE_URL=jdbc:postgresql://inspecta-postgres-ostetc:5432/inspecta
DATABASE_USER=inspecta
DATABASE_PASSWORD=MESMA_SENHA_DO_INFRA_ENV

# --- RabbitMQ (OBRIGATÓRIO) ------------------------------------------------
RABBITMQ_HOST=inspecta-rabbitmq-i6kk2u
RABBITMQ_PORT=5672
RABBITMQ_USER=inspecta
RABBITMQ_PASSWORD=MESMA_SENHA_DO_INFRA_ENV

# --- Auth (OBRIGATÓRIO) ----------------------------------------------------
# Assina o access token. NUNCA reusar o segredo de dev/staging.
# Gere: openssl rand -base64 48
JWT_SECRET=TROQUE_ME

# --- Pagamento (OBRIGATÓRIO) -----------------------------------------------
# `mock` só é aceito no profile test. Em prod use o provider real (ex.: abacatepay).
PAYMENT_PROVIDER=abacatepay

# --- Webhooks de terceiros -------------------------------------------------
# Os webhooks de assinatura (Autentique) e pagamento (AbacatePay) entram pelo
# inspecta-messenger, não pelo inspecta-api — AUTENTIQUE_WEBHOOK_SECRET e ABACATEPAY_WEBHOOK_SECRET
# vivem em inspecta-messenger/.env.prod.example. O inspecta-api só recebe o webhook de métricas,
# protegido por API key (X-API-Key com escopo `metricas`), sem segredo HMAC.

# --- Pleno (OBRIGATÓRIO) ---------------------------------------------------
# mode=http liga o cliente HTTP real; mode=mock só vale em test.
PLENO_MODE=http
PLENO_BASE_URL=https://SEU-SUBDOMINIO.sistemaspleno.com
PLENO_CLIENT_ID=
PLENO_CLIENT_SECRET=

# --- Opcionais (têm default no application.yml) ----------------------------
PLENO_POLL_MS=60000
PLENO_CACHE_TTL_SECONDS=900
PLENO_TIMEOUT_SECONDS=3

# --- Runtime ---------------------------------------------------------------
IMAGE_TAG=latest
API_MEM_LIMIT=1g
API_JAVA_OPTS=-XX:MaxRAMPercentage=70
TZ=America/Sao_Paulo
